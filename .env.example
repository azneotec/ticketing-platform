# Local development secrets for the Compose platform. NOT for any real environment.
# `make up` copies this file to .env (git-ignored) if .env does not exist yet; change values there.
# Phase 4 replaces this file with OpenBao + External Secrets Operator (ADR-021).
#
# Postgres reads these only on the FIRST start (empty volume). After changing them, run
# `make reset` (destroys data) or change the passwords with ALTER ROLE.

# Superuser (admin only; services never use it)
POSTGRES_PASSWORD=postgres-local-dev

# One login per service, each limited to its own database (ADR-028)
CATALOGUE_DB_PASSWORD=catalogue-local-dev
INVENTORY_DB_PASSWORD=inventory-local-dev
BOOKING_DB_PASSWORD=booking-local-dev
PAYMENT_DB_PASSWORD=payment-local-dev
